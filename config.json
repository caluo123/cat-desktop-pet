{
  "version": 3,
  "remote": {
    "enabled": true,
    "config_url": "https://cdn.jsdelivr.net/gh/caluo123/cat-desktop-pet@main/config.json",
    "assets_base": "https://cdn.jsdelivr.net/gh/caluo123/cat-desktop-pet@main/assets/cat"
  },
  "states": {
    "idle":  {"frames": 8,  "interval_ms": 300, "loop": true,  "label": "发呆"},
    "blink": {"frames": 4,  "interval_ms": 240, "loop": false, "label": "眨眼"},
    "walk":  {"frames": 8,  "interval_ms": 480, "loop": true,  "label": "立即走动"},
    "pet":   {"frames": 8,  "interval_ms": 200, "loop": false, "label": "被抚摸"},
    "sleep": {"frames": 10, "interval_ms": 440, "loop": true,  "label": "睡觉"}
  },
  "menu": {
    "show_actions": true,
    "actions_submenu_label": "动作",
    "show_hearts": true,
    "hearts_label": "发射爱心彩蛋",
    "show_speech": true,
    "speech_label": "说句话",
    "show_pause": true,
    "show_size": true,
    "show_sleep": true,
    "show_exit": true
  },
  "behavior": {
    "walk_speed": 2,
    "walk_min_seconds": 6,
    "walk_max_seconds": 15,
    "blink_chance": 0.004,
    "walk_chance": 0.02,
    "sleep_after_min": 45,
    "sleep_after_max": 70,
    "sleep_duration_min": 15,
    "sleep_duration_max": 40
  },
  "speech": {
    "enabled": true,
    "random_interval_min": 25,
    "random_interval_max": 60,
    "duration_ms": 3500,
    "phrases": [
      "喵~",
      "今天也要元气满满！",
      "摸摸我嘛~",
      "想吃小鱼干",
      "陪我玩一会儿",
      "困了，想睡觉zzz",
      "主人今天好忙呀",
      "发射爱心~ 啾",
      "我超可爱的！"
    ]
  }
}
